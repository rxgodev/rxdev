# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Declare binary files (should not be modified)
*.png binary
*.jpg binary
*.gif binary