{
  "name": "@rxgodev/rxdev",
  "version": "4.0.0",
  "description": "AI-powered developer workflow tool",
  "keywords": [
    "git",
    "commit",
    "ai",
    "cli",
    "code-review",
    "conventional-commits",
    "rxdev"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "rxdev": "bin/rxdev.js",
    "qq": "bin/rxdev.js"
  },
  "scripts": {
    "test": "node --test tests/test_rxdev.mjs",
    "test:coverage": "c8 node --test tests/test_rxdev.mjs",
    "lint": "npx @biomejs/biome check .githooks/ bin/ tests/",
    "format": "npx @biomejs/biome format --write .githooks/ bin/ tests/"
  },
  "dependencies": {
    "inquirer": "^9.0.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    ".githooks/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/rxgodev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxgodev/rxcommit.git"
  },
  "bugs": {
    "url": "https://github.com/rxgodev/rxcommit/issues"
  },
  "homepage": "https://github.com/rxgodev/rxcommit#readme"
}
